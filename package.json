{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run schemas && vite build",
    "schemas": "tsx scripts/export-schemas.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0 resources/js scripts tests/e2e tests/Engagement",
    "format": "prettier --write resources/js resources/css scripts tests/e2e tests/Engagement playwright.config.ts vite.config.ts",
    "format:check": "prettier --check resources/js resources/css scripts tests/e2e tests/Engagement playwright.config.ts vite.config.ts",
    "test:e2e": "playwright test",
    "test:sandbox": "playwright test -c tests/Engagement/playwright.sandbox.config.ts",
    "test:deploy": "bash tests/deploy/run.sh"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@inertiajs/react": "^2.2.0",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "idiomorph": "^0.7.4",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7",
    "globals": "^16",
    "laravel-vite-plugin": "^3.2.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vite": "^8.0.0"
  }
}
