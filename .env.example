# Local development. For the live site use .env.production.example (scripts/make-env.php).
APP_NAME="Sakila per il Nepal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
# Public site default language (the CMS UI is English).
APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

# MySQL 8 / MariaDB 10.4+ (utf8mb4). Local XAMPP: root with no password.
# cPanel: DB_DATABASE=cpaneluser_sakila, DB_USERNAME=cpaneluser_sakila, DB_HOST=localhost
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sakila_laravel
DB_USERNAME=root
DB_PASSWORD=

# Sessions in the database (`http_sessions`) so admins can be signed out everywhere. 7 days.
SESSION_DRIVER=database
SESSION_TABLE=http_sessions
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE defaults to true when APP_ENV=production (HTTPS required).

# File cache works everywhere (TagCache adds tag invalidation on top).
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Reverse proxy. TRUST_PROXY=true only if the site is behind Cloudflare or a proxy you control;
# TRUSTED_PROXIES says whose forwarded headers count: "cloudflare" (default), a comma-separated
# list of IPs/CIDR ranges, or "*" (anyone who connects: only if the origin is firewalled).
TRUST_PROXY=false
TRUSTED_PROXIES=cloudflare

# Retention, enforced daily by `php artisan sakila:housekeeping` (0 = keep forever).
AUDIT_IP_RETENTION_DAYS=90
AUDIT_RETENTION_MONTHS=24
# Resized image variants: folder (default storage/app/img-cache) and size cap in MB.
IMG_CACHE_DIR=
IMG_CACHE_MAX_MB=300

# Uploads: local disk (cPanel). In production LOCAL_UPLOADS_DIR is REQUIRED and must be an absolute
# folder OUTSIDE the app, e.g. /home/<cpaneluser>/sakila-uploads (deploys never delete photos).
STORAGE_DRIVER=local
LOCAL_UPLOADS_DIR=
UPLOAD_MAX_IMAGE_MB=10
UPLOAD_MAX_DOCUMENT_MB=25
# STORAGE_DRIVER=s3 (Cloudflare R2 / S3 / MinIO):
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Mail. Locally `log` writes emails to storage/logs. Production: cPanel mailbox SMTP
# (see .env.production.example).
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.org"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_TIMEOUT=10
NOTIFY_EMAIL_TO=

# Salts (default to APP_KEY locally; set explicitly in production via scripts/make-env.php).
IP_HASH_SALT=
NEWSLETTER_TOKEN_SECRET=
# One-time /install page (first super admin without SSH). 16+ chars; remove after installing.
INSTALL_TOKEN=

# Newsletter provider: empty/smtp (built-in double opt-in) | brevo | mailchimp.
NEWSLETTER_PROVIDER=
# Optional Cloudflare Turnstile.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Payments (empty = method shown as "coming soon"; test keys are fine locally).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
ESEWA_ENV=test
ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=
KHALTI_ENV=test
KHALTI_SECRET_KEY=

# Seed accounts (php artisan db:seed). Production seeding needs SEED_ALLOW_PRODUCTION=true and a
# strong, non-default SEED_ADMIN_PASSWORD; demo editor/author are never created in production.
SEED_ADMIN_EMAIL=admin@sakila.local
SEED_ADMIN_PASSWORD=ChangeMe-Sakila-2026!
SEED_ADMIN_NAME="Sakila Admin"
SEED_DEMO_PASSWORD=ChangeMe-Sakila-2026!
SEED_DEMO_USERS=true
SEED_ALLOW_PRODUCTION=false
