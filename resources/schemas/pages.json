      "locale",
      "sections"
    ]
  },
  "slugSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "string",
    "minLength": 1,
    "maxLength": 80,
    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
    "x-trim": true,
    "x-lowercase": true
  },
  "stagePreviewSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
