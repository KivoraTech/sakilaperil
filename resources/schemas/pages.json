      "slug": {
        "type": "string",
        "maxLength": 80,
        "x-trim": true,
        "x-lowercase": true
      },
      "seoTitle": {
        "type": "string",
        "maxLength": 70,
        "x-trim": true
      },
      "seoDescription": {
        "type": "string",
        "maxLength": 160,
        "x-trim": true
      },
      "ogImageId": {
        "type": "string",
        "maxLength": 64,
        "x-trim": true
      },
      "noIndex": {
        "default": false,
        "type": "boolean"
      }
    },
    "required": [
      "pageId",
      "locale",
      "title",
      "slug"
    ]
  },
  "pageTitleSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "string",
    "minLength": 1,
    "maxLength": 160,
    "x-trim": true
