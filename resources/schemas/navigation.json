{
  "navItemSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "label": {
        "type": "object",
        "properties": {
          "it": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "x-trim": true
          },
          "en": {
            "type": "string",
            "maxLength": 60,
            "x-trim": true
          }
        },
        "required": [
          "it"
        ]
      },
      "linkType": {
        "type": "string",
        "enum": [
          "PAGE",
          "ROUTE",
          "INTERNAL",
          "EXTERNAL"
        ]
      },
      "pageId": {
        "type": "string",
        "maxLength": 64
      },
      "routeKey": {
        "type": "string",
        "maxLength": 40
      },
      "href": {
        "type": "string",
        "maxLength": 500,
        "x-trim": true
      },
      "openInNewTab": {
        "default": false,
        "type": "boolean"
      },
      "isVisible": {
        "default": true,
        "type": "boolean"
      },
      "depth": {
        "default": 0,
        "anyOf": [
          {
            "type": "number",
            "const": 0
          },
          {
            "type": "number",
            "const": 1
          }
        ]
      }
    },
    "required": [
      "label",
      "linkType"
    ]
  },
  "saveNavigationSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "key": {
        "type": "string",
        "enum": [
          "header",
          "footer-explore",
          "footer-help",
          "footer-legal"
        ]
      },
      "items": {
        "maxItems": 40,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "label": {
              "type": "object",
              "properties": {
                "it": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60,
                  "x-trim": true
                },
                "en": {
                  "type": "string",
                  "maxLength": 60,
                  "x-trim": true
                }
              },
              "required": [
                "it"
              ]
            },
            "linkType": {
              "type": "string",
              "enum": [
                "PAGE",
                "ROUTE",
                "INTERNAL",
                "EXTERNAL"
              ]
            },
            "pageId": {
              "type": "string",
              "maxLength": 64
            },
            "routeKey": {
              "type": "string",
              "maxLength": 40
            },
            "href": {
              "type": "string",
              "maxLength": 500,
              "x-trim": true
            },
            "openInNewTab": {
              "default": false,
              "type": "boolean"
            },
            "isVisible": {
              "default": true,
              "type": "boolean"
            },
            "depth": {
              "default": 0,
              "anyOf": [
                {
                  "type": "number",
                  "const": 0
                },
                {
                  "type": "number",
                  "const": 1
                }
              ]
            }
          },
          "required": [
            "label",
            "linkType"
          ]
        }
      }
    },
    "required": [
      "key",
      "items"
    ]
  }
}
