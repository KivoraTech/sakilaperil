{
  "contactSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "x-trim": true
      },
      "email": {
        "type": "string",
        "minLength": 1,
        "maxLength": 254,
        "x-trim": true
      },
      "phone": {
        "type": "string",
        "maxLength": 40,
        "pattern": "^[+()\\d\\s./-]*$",
        "x-trim": true
      },
      "subject": {
        "type": "string",
        "enum": [
          "info",
          "donations",
          "volunteering",
          "partnership",
          "press",
          "other"
        ]
      },
      "message": {
        "type": "string",
        "minLength": 1,
        "maxLength": 5000,
        "x-trim": true
      },
      "consent": {
        "type": "boolean",
        "const": true
      }
    },
    "required": [
      "name",
      "email",
      "message",
      "consent"
    ]
  },
