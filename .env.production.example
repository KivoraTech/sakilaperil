# ─────────────────────────────────────────────────────────────────────────────────────────────
# Sakila per il Nepal — PRODUCTION settings for cPanel (Babal Host). Copy to ~/sakila/.env.
# Easiest: `php scripts/make-env.php` on your computer prints this file with every secret
# (APP_KEY, salts, INSTALL_TOKEN) already generated. Values in <ANGLE BRACKETS> are yours to fill.
# Never share this file: it contains passwords and keys.
# ─────────────────────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────────────────────
APP_NAME="Sakila per il Nepal"
APP_ENV=production
# Must stay false on the live site (true shows error details to visitors).
APP_DEBUG=false
# Encryption key for sessions/cookies. Generated by scripts/make-env.php. Never change it later
# (everyone would be signed out). Format: base64:...
APP_KEY=
# Your public address, https:// and no trailing slash. Used in emails, sitemap, payment returns.
APP_URL=https://<your-domain>
SITE_URL=https://<your-domain>
APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

# ── Logs (~/sakila/storage/logs/laravel-YYYY-MM-DD.log, kept 14 days) ───────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=info

# ── Database (cPanel → MySQL® Databases). cPanel prefixes names with your account user. ─────
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<cpaneluser>_sakila
DB_USERNAME=<cpaneluser>_sakila
# If the password contains # or spaces, keep the quotes.
DB_PASSWORD="<database-user-password>"

# ── Sessions / cache / queue (no extra services needed on shared hosting) ───────────────────
# Admin sessions live in the database so "sign out everywhere" works. Do not change.
SESSION_DRIVER=database
SESSION_TABLE=http_sessions
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
# Cache public pages' data (menus, settings, lists); invalidated automatically on publish.
PUBLIC_CACHE=true
# true only if the site sits behind Cloudflare (orange cloud) or another proxy you control.
# TRUSTED_PROXIES: "cloudflare" (default) or a comma-separated list of the proxy's IPs / ranges.
TRUST_PROXY=false
TRUSTED_PROXIES=cloudflare

# ── Housekeeping (daily, needs the cron job): how long things are kept. 0 = forever. ────────
# Admin activity log: IP address and browser are blanked after N days, entries deleted after N months.
AUDIT_IP_RETENTION_DAYS=90
AUDIT_RETENTION_MONTHS=24
# Resized photos are regenerated on demand; the cache folder is kept under this size (MB).
# It lives outside ~/sakila so installing a new version does not throw it away. Safe to delete.
IMG_CACHE_DIR=/home/<cpaneluser>/sakila-img-cache
IMG_CACHE_MAX_MB=300

# ── Uploaded photos & PDFs: a folder OUTSIDE public_html and outside ~/sakila, so updates
#    never delete them. Create it in File Manager. Absolute path required. ──────────────────
STORAGE_DRIVER=local
LOCAL_UPLOADS_DIR=/home/<cpaneluser>/sakila-uploads
UPLOAD_MAX_IMAGE_MB=10
UPLOAD_MAX_DOCUMENT_MB=25

# ── Email through a cPanel mailbox (cPanel → Email Accounts → "Connect Devices" shows these).
#    Port 465 = SSL (MAIL_SCHEME=smtps), port 587 = STARTTLS (MAIL_SCHEME=smtp). ─────────────
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.<your-domain>
MAIL_PORT=465
MAIL_USERNAME=noreply@<your-domain>
MAIL_PASSWORD="<mailbox-password>"
MAIL_FROM_ADDRESS=noreply@<your-domain>
MAIL_FROM_NAME="Sakila per il Nepal"
MAIL_TIMEOUT=10
# Who receives "new contact form / volunteer / donation" notifications (comma-free, one address).
NOTIFY_EMAIL_TO=info@<your-domain>

# ── Security salts (generated by scripts/make-env.php; keep them stable) ────────────────────
# Hashes visitor IPs for rate limits (raw IPs are never stored).
IP_HASH_SALT=
# Signs newsletter confirm/unsubscribe links.
NEWSLETTER_TOKEN_SECRET=

# ── First install only: enables the one-time https://<your-domain>/install page that creates
#    the first administrator. Delete this line after you have signed in. ───────────────────
INSTALL_TOKEN=

# ── Newsletter: empty/"smtp" = built-in double opt-in by email; or "brevo" / "mailchimp". ───
NEWSLETTER_PROVIDER=
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_DOI_TEMPLATE_ID=
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SERVER_PREFIX=

# ── Optional spam protection: Cloudflare Turnstile (free). Leave empty to use honeypot+limits. ─
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Payments (leave empty = that method shows "coming soon"; bank transfer always works). ────
# Stripe (cards, Apple/Google Pay). Webhook URL: https://<your-domain>/api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# PayPal. ENV: sandbox | live. Webhook URL: https://<your-domain>/api/webhooks/paypal
PAYPAL_ENV=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# eSewa (Nepal). ENV: test | live.
ESEWA_ENV=live
ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=
# Khalti (Nepal). ENV: test | live.
KHALTI_ENV=live
KHALTI_SECRET_KEY=

# ── Optional: store uploads in Cloudflare R2 / S3 instead (STORAGE_DRIVER=s3). ──────────────
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
